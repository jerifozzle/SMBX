    "bonus1.lvlx": {
        "events": [
            {
                "i": 3,
                "msg": "#if player(3)\n你给我出去！\n我才不管你是不是公主呢，给我出去！\n#else\n你这家伙，给我马上出去！\n#endif",
                "orig": "#if player(3)\nHey, you! Get off my lawn!\nI don't care if you're a princess, just, get out!\n#else\nYou boys better get off my lawn!\n#endif",
                "u": true
            }
        ],
        "npc": [
            {
                "i": 5,
                "orig": "Stay outta my house.  The door's locked and I don't even want you thinkin' about going down my chimney.",
                "talk": "赶快从我的小屋出去！即使门上了锁，我也不能让你从烟囱进去。",
                "u": true
            },
            {
                "i": 6,
                "orig": "I can't believe you broke into my house.  You better not have hurt Hugo!",
                "talk": "我不能相信你闯到我的屋里。你别在那里搞破坏！",
                "u": true
            }
        ]
    },
    "bonus2.lvlx": {
        "npc": [
            {
                "i": 6,
                "orig": "Take anything you want!",
                "talk": "您想要什么就要什么！",
                "u": true
            }
        ]
    },
